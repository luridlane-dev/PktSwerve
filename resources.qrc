<!DOCTYPE RCC><RCC version="1.0">
<qresource prefix="/icons">
    <file alias="active.png">resources/icons/active.png</file>
    <file alias="inactive.png">resources/icons/inactive.png</file>
    <file alias="app.ico">resources/icons/app.ico</file>
    <file alias="chevron.png">resources/icons/chevron.png</file>
    <file alias="chevron@2x.png">resources/icons/chevron@2x.png</file>
</qresource>
<qresource prefix="/update">
    <file alias="apply-update.ps1">packaging/windows/apply-update.ps1</file>
    <file alias="apply-update.sh">packaging/macos/apply-update.sh</file>
</qresource>
</RCC>